{
  "trading_timeframe": "4h",
  "scan_interval_seconds": 1800,
  "auto_execute_signals": true,
  "rate_limit_delay": 0.1,

  "strategy_mode": "trend_hold",
  "trend_hold": { "entry_days": 55, "exit_days": 20 },
  "btc_gate_days": 50,
  "trend_hold_live_enabled": true,

  "auto_entries": true,
  "auto_max_positions": 2,
  "max_positions": 5,

  "adopt_manual_positions": true,
  "adopt_min_usd": 15,
  "adopt_ignore": ["BNB"],
  "manual_override_seconds": 300,

  "use_limit_orders": true,
  "risk_per_trade": 0.03,
  "spot_fee": 0.001,
  "trading_fee": 0.0005,
  "futures_fee": 0.0005,

  "max_drawdown": 0.05,
  "circuit_breaker_cooldown_hours": 48,

  "enable_futures": false,
  "enable_shorts": false,
  "futures_live_enabled": false,

  "use_daily_trend_filter": true,
  "use_volume_shrinkage": true,
  "stop_atr_multiplier": 3,
  "stop_loss_min_pct": 0.03,
  "stop_loss_max_pct": 0.12,
  "default_stop_loss_pct": 0.04,
  "min_rr": 3,
  "max_position_size": 0.1,
  "trailing_stop_min_pct": 0.04,
  "trailing_stop_max_pct": 0.08,
  "trailing_activation_pct": 0.15,
  "futures_leverage": 1,

  "coins": [
    "SOL/USDC", "BTC/USDC", "ETH/USDC", "BNB/USDC",
    "ADA/USDC", "CRV/USDC", "XLM/USDC", "LTC/USDC",
    "AVAX/USDC", "DOT/USDC", "LINK/USDC", "UNI/USDC",
    "ATOM/USDC", "TRX/USDC", "ALGO/USDC"
  ],
  "extra_coins": [],
  "use_websocket": false,
  "binance_testnet_api_url": "https://testnet.binance.vision/api",

  "per_pair": {
    "ETH/USDC": { "risk_per_trade": 0.05, "trailing_min_pct": 0.06, "trailing_max_pct": 0.10 },
    "SOL/USDC": { "risk_per_trade": 0.05, "trailing_min_pct": 0.07, "trailing_max_pct": 0.09 },
    "BNB/USDC": { "risk_per_trade": 0.05, "trailing_min_pct": 0.05, "trailing_max_pct": 0.08 },
    "BTC/USDC": { "risk_per_trade": 0.05, "trailing_min_pct": 0.06, "trailing_max_pct": 0.09 }
  }
}
